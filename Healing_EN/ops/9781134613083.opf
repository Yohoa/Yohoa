<package xmlns="http://www.idpf.org/2007/opf" unique-identifier="p9781134613083" version="3.0" prefix="calibre: https://calibre-ebook.com">
  <metadata xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:opf="http://www.idpf.org/2007/opf">
    <dc:title id="id">Healing the Fragmented Selves of Trauma Survivors: Overcoming Internal Self-Alienation</dc:title>
    <dc:creator id="id-2">Janina Fisher</dc:creator>
    <dc:format>292 Pages</dc:format>
    <dc:identifier>google:NJ40DgAAQBAJ</dc:identifier>
    <dc:identifier>isbn:9781134613083</dc:identifier>
